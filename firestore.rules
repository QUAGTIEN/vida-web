rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Phiếu nhận xét: giữ nguyên quyền hiện tại để giáo viên không cần Firebase Auth vẫn lưu được.
    match /records/{docId} {
      allow read, write: if true;
    }

    // Nhật ký thao tác dọn dẹp chỉ dành cho tài khoản quản lý.
    match /cleanup_jobs/{jobId} {
      allow read, write: if request.auth != null;
    }

    match /students/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /facilities/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /classes/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /teachers/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /excel_schedules/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /SystemMeta/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /ThongKe/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
